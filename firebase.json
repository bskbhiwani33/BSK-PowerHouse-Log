{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    }
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "netlify/**",
      ".github/**",
      "scripts/**",
      "README*",
      "*.md",
      "*.txt",
      "package.json",
      "package-lock.json",
      "netlify.toml",
      "firestore.rules",
      "firestore.indexes.json"
    ],
    "rewrites": [
      {
        "source": "/.netlify/functions/login",
        "function": {
          "functionId": "login",
          "region": "asia-south1"
        }
      },
      {
        "source": "/.netlify/functions/admin",
        "function": {
          "functionId": "admin",
          "region": "asia-south1"
        }
      },
      {
        "source": "/.netlify/functions/records",
        "function": {
          "functionId": "records",
          "region": "asia-south1"
        }
      },
      {
        "source": "/.netlify/functions/create-admin",
        "function": {
          "functionId": "createAdmin",
          "region": "asia-south1"
        }
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/app.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/bsk-config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
